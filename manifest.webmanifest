{
  "name": "WRSTL Legends",
  "short_name": "WRSTL",
  "description": "Create your wrestler and follow the WRSTL pathway from your first club night in Glasgow all the way to the Games.",
  "id": "/wrstl-legends/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0e0c11",
  "theme_color": "#0e0c11",
  "categories": [
    "games",
    "sports",
    "education"
  ],
  "lang": "en-GB",
  "dir": "ltr",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "My passport",
      "short_name": "Passport",
      "description": "Your stamps and Pride’s Pack",
      "url": "./#passport",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}